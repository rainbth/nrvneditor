{
  "name": "nrvn",
  "version": "1.0.13",
  "private": true,
  "description": "Editor local de Markdown con agentes, para macOS",
  "license": "MIT",
  "author": "rainbrth",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "mock": "VITE_MOCK_BRIDGE=1 electron-vite dev",
    "build": "electron-vite build && electron-builder --mac --arm64",
    "build:mock": "VITE_MOCK_BRIDGE=1 electron-vite build",
    "build:app": "electron-vite build",
    "preview": "vite preview --outDir out/renderer --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage && npm run build:app && npm run check:bundle && npm run test:e2e",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --mac --arm64",
    "prebuild": "node scripts/bump-version.mjs",
    "predist": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "*",
    "@codemirror/lang-markdown": "*",
    "@codemirror/language": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@fontsource/lato": "^5.3.0",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "codemirror": "*",
    "diff": "*",
    "lucide-react": "*",
    "motion": "^14.9.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "*",
    "rehype-sanitize": "*",
    "remark-gfm": "*",
    "shiki": "*",
    "zod": "*",
    "zustand": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "*",
    "@playwright/test": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45",
    "electron-builder": "*",
    "electron-vite": "^6",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
